{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.replit)",
      "Read(./replit.nix)",
      "Read(./**/secrets/**)",
      "Read(./.netlify/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(npm publish*)",
      "Bash(supabase db reset*)",
      "Bash(psql * -c \"drop*)",
      "Bash(psql * -c \"truncate*)",
      "Bash(cat *.env*)",
      "Bash(cat *secrets/*)",
      "Bash(cat *.replit*)",
      "Bash(cat *replit.nix*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(strings *.env*)",
      "Bash(xxd *.env*)",
      "Bash(od *.env*)",
      "Bash(grep * .env*)",
      "Bash(rg * .env*)",
      "Bash(awk * .env*)",
      "Bash(sed * .env*)",
      "Bash(cp *.env*)",
      "Bash(mv *.env*)",
      "Bash(tar * .env*)",
      "Bash(zip * .env*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(set)",
      "Bash(export -p)",
      "Bash(netlify env:list*)",
      "Bash(netlify env:get*)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git checkout -- *)",
      "Bash(git rm -r*)",
      "Bash(git add *.env*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref -d*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(netlify deploy*)",
      "Bash(netlify env:set*)",
      "Bash(netlify env:unset*)",
      "Bash(supabase *)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(./data.js)",
      "Edit(./netlify/functions/**)",
      "Edit(./package.json)",
      "Edit(./netlify.toml)",
      "Edit(./_redirects)",
      "Edit(./.gitignore)",
      "Bash(git add*)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run test*)",
      "Bash(npx netlify dev*)",
      "Bash(node scripts/*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(rg *)",
      "Bash(grep *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "kadjvnpndpwptmibvahc.supabase.co",
        "api.supabase.com",
        "api.resend.com",
        "api.netlify.com",
        "api.paypal.com",
        "api-m.paypal.com",
        "fonts.googleapis.com",
        "fonts.gstatic.com"
      ]
    }
  },
  "_policy_note": "Deny wins over allow at every layer. The Bash entries above exist because Read(./.env) does not stop `cat .env` \u2014 the Read tool and the Bash tool are separate surfaces. Same reasoning the sandbox uses for curl vs WebFetch."
}